# macOS
.DS_Store

# KiCad working files
*-backups/
*.kicad_prl
fp-info-cache
*.bak
*~
~*.lck

# Python
__pycache__/
*.pyc

# KiCad fabrication output is regenerated, not committed, until release
/pcb/*/*-backups/

# Reference photos of third-party hardware: kept locally, not carried in the repo
/images/

# Local ESPHome working copy with real credentials; the sanitised version is bench/esphome/as50qdfhra.yaml
esphome.cfg

# Vendor CAD downloads staged for import into lib/; not part of the design
import/

# kicad-happy analysis output: regenerable, and the manifest is not worth the churn
/analysis/

# kicad-cli ERC and DRC reports: regenerated on demand
*-erc.rpt
*-drc.rpt
